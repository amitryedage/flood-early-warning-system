# Server Configuration
PORT=3000

# OpenWeatherMap API Key
# Sign up for free at: https://openweathermap.org/api
# Free tier: 1,000 calls/day, 60 calls/minute
OPENWEATHER_API_KEY=your_api_key_here

# Weather Update Interval (in milliseconds)
# Default: 300000 (5 minutes) to respect API rate limits
WEATHER_UPDATE_INTERVAL=300000

# Default Monitoring Location (Godavari River Basin, India)
DEFAULT_LAT=18.0
DEFAULT_LNG=82.0

# Satellite Service Configuration (Microsoft Planetary Computer)
# Cache duration for satellite imagery data (in milliseconds)
SATELLITE_CACHE_DURATION=3600000  # 1 hour
# Search radius for satellite imagery (in degrees, ~11km per 0.1 degree)
SATELLITE_DEFAULT_RADIUS=0.1
# Maximum acceptable cloud cover percentage for imagery
SATELLITE_MAX_CLOUD_COVER=10
